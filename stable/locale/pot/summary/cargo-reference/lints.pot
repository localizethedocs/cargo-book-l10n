#: src/reference/lints.md:461 src/reference/lints.md:504
#: src/reference/lints.md:535 src/reference/lints.md:557
msgid "Example"
msgstr ""

#: src/reference/lints.md:67
msgid ""
"```toml\n"
"[profile.dev.package.\"*\"]\n"
"hint-mostly-unused = true\n"
"```"
msgstr ""

