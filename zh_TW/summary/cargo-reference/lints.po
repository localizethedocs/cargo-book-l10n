#: src/reference/lints.md:491 src/reference/lints.md:513
msgid "Example"
msgstr "範例"

#: src/reference/lints.md:61
msgid ""
"```toml\n"
"[profile.dev.package.\"*\"]\n"
"hint-mostly-unused = true\n"
"```"
msgstr ""
"```toml\n"
