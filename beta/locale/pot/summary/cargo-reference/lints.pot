msgstr ""

#: src/reference/lints.md:395
msgid "Adds boilerplate."
msgstr ""

#: src/reference/lints.md:399
msgid "It might not be obvious if they named their file correctly."
msgstr ""

#: src/reference/lints.md:403
msgid ""
